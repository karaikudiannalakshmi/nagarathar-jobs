rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() { return request.auth != null; }

    match /nj_users/{uid} {
      allow read:   if isAuth();
      allow create: if isAuth() && request.auth.uid == uid;
      allow update: if isAuth() && request.auth.uid == uid;
    }
    match /nj_jobs/{jobId} {
      allow read:   if isAuth();
      allow create: if isAuth();
      allow update: if isAuth() && resource.data.postedBy == request.auth.uid;
      allow delete: if isAuth() && resource.data.postedBy == request.auth.uid;
    }
    match /nj_applications/{appId} {
      allow read:   if isAuth() && (
        resource.data.applicantUid == request.auth.uid ||
        resource.data.posterUid    == request.auth.uid
      );
      allow create: if isAuth() && request.resource.data.applicantUid == request.auth.uid;
      allow update: if isAuth() && resource.data.posterUid == request.auth.uid;
    }
    match /nj_skills/{id}            { allow read, write: if isAuth(); }
    match /nj_skill_suggestions/{id} { allow read, create, delete: if isAuth(); }
    // Activity logging — any auth user can write, only auth can read
    match /nj_activity/{id}          { allow read, create: if isAuth(); }
    // Follow-up dedup tracking
    match /nj_followup_sent/{id}     { allow read, create: if isAuth(); }
  }
}
